// E-commerce — after dbdiagram.io's official example (SQL-representable subset).
Enum products_status {
  out_of_stock
  in_stock
  running_low
}

Table users {
  id int [pk, increment]
  full_name varchar
  created_at timestamp
  country_code int
}

Table countries {
  code int [pk]
  name varchar
  continent_name varchar
}

Table merchants {
  id int [pk, increment]
  country_code int
  merchant_name varchar
  "created at" varchar
  admin_id int
}

Table orders {
  id int [pk]
  user_id int [not null, unique]
  status varchar
  created_at varchar [note: 'When order created']

  Note: 'Customer orders'
}

Table products {
  id int [pk]
  name varchar
  merchant_id int [not null]
  price decimal(10,2) [default: 0]
  status products_status [default: 'in_stock']
  created_at timestamp [default: `now()`]

  indexes {
    (merchant_id, status) [name: 'product_status']
    id [unique]
  }
}

Table order_items {
  order_id int
  product_id int
  quantity int [default: 1]

  indexes {
    (order_id, product_id) [pk]
  }
}

Ref: products.merchant_id > merchants.id
Ref: users.country_code > countries.code [delete: set null, update: cascade]
Ref: merchants.country_code > countries.code
Ref: order_items.order_id > orders.id
Ref: order_items.product_id > products.id
Ref fk_admin: merchants.admin_id > users.id
