// School — students, teachers, courses, enrollments, grades
Table students {
  id int [pk, increment]
  first_name varchar(100) [not null]
  last_name varchar(100) [not null]
  email varchar(254) [unique]
  date_of_birth date
  enrolled_on date [not null]
}

Table teachers {
  id int [pk, increment]
  first_name varchar(100) [not null]
  last_name varchar(100) [not null]
  email varchar(254) [not null, unique]
  department varchar(100)
}

Table courses {
  id int [pk, increment]
  code varchar(16) [not null, unique]
  title varchar(200) [not null]
  credits int [not null, default: 3]
  teacher_id int [ref: > teachers.id]
}

Table terms {
  id int [pk, increment]
  name varchar(50) [not null]
  starts_on date [not null]
  ends_on date [not null]
}

Table sections {
  id int [pk, increment]
  course_id int [not null, ref: > courses.id]
  term_id int [not null, ref: > terms.id]
  room varchar(20)
  capacity int [not null, default: 30]
  indexes {
    (course_id, term_id) [unique]
  }
}

Table enrollments {
  id int [pk, increment]
  student_id int [not null, ref: > students.id]
  section_id int [not null, ref: > sections.id]
  status enrollment_status [not null, default: 'active']
  enrolled_at timestamp [not null, default: `now()`]
  indexes {
    (student_id, section_id) [unique]
  }
}

Table grades {
  id int [pk, increment]
  enrollment_id int [not null, ref: > enrollments.id]
  assessment varchar(100) [not null]
  score decimal(5,2) [not null]
  graded_at timestamp [not null, default: `now()`]
}

Enum enrollment_status {
  active
  dropped
  completed
}
