// SaaS multi-tenant — organizations, memberships, projects, billing
Table organizations {
  id int [pk, increment]
  slug varchar(64) [not null, unique]
  name varchar(200) [not null]
  plan plan_tier [not null, default: 'free']
  created_at timestamp [not null, default: `now()`]
}

Table users {
  id int [pk, increment]
  email varchar(254) [not null, unique]
  display_name varchar(120) [not null]
  is_active boolean [not null, default: true]
  last_login_at timestamp
}

Table memberships {
  id int [pk, increment]
  organization_id int [not null, ref: > organizations.id]
  user_id int [not null, ref: > users.id]
  role member_role [not null, default: 'member']
  invited_at timestamp [not null, default: `now()`]
  accepted_at timestamp
  indexes {
    (organization_id, user_id) [unique]
  }
}

Table projects {
  id int [pk, increment]
  organization_id int [not null, ref: > organizations.id]
  name varchar(200) [not null]
  archived boolean [not null, default: false]
  created_by_id int [ref: > users.id]
  indexes {
    (organization_id, name) [unique]
  }
}

Table api_keys {
  id int [pk, increment]
  organization_id int [not null, ref: > organizations.id]
  name varchar(100) [not null]
  key_hash varchar(128) [not null, unique]
  last_used_at timestamp
  revoked_at timestamp
}

Table subscriptions {
  id int [pk, increment]
  organization_id int [not null, unique, ref: - organizations.id]
  provider_customer_id varchar(100) [not null]
  status subscription_status [not null, default: 'trialing']
  current_period_end timestamp
}

Table invoices {
  id int [pk, increment]
  subscription_id int [not null, ref: > subscriptions.id]
  number varchar(40) [not null, unique]
  amount_cents int [not null]
  currency varchar(3) [not null, default: 'USD']
  issued_at timestamp [not null, default: `now()`]
  paid_at timestamp
}

Table audit_log {
  id bigint [pk, increment]
  organization_id int [not null, ref: > organizations.id]
  actor_id int [ref: > users.id]
  action varchar(100) [not null]
  target varchar(200)
  created_at timestamp [not null, default: `now()`]
  indexes {
    (organization_id, created_at)
  }
}

Enum plan_tier {
  free
  pro
  enterprise
}

Enum member_role {
  owner
  admin
  member
  viewer
}

Enum subscription_status {
  trialing
  active
  past_due
  canceled
}
