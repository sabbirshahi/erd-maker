// Django auth — the tables django.contrib.auth + contenttypes create
Table django_content_type {
  id int [pk, increment]
  app_label varchar(100) [not null]
  model varchar(100) [not null]
  indexes {
    (app_label, model) [unique]
  }
}

Table auth_permission {
  id int [pk, increment]
  name varchar(255) [not null]
  content_type_id int [not null, ref: > django_content_type.id]
  codename varchar(100) [not null]
  indexes {
    (content_type_id, codename) [unique]
  }
}

Table auth_group {
  id int [pk, increment]
  name varchar(150) [not null, unique]
}

Table auth_group_permissions {
  id bigint [pk, increment]
  group_id int [not null, ref: > auth_group.id]
  permission_id int [not null, ref: > auth_permission.id]
  indexes {
    (group_id, permission_id) [unique]
  }
}

Table auth_user {
  id int [pk, increment]
  password varchar(128) [not null]
  last_login timestamp
  is_superuser boolean [not null, default: false]
  username varchar(150) [not null, unique]
  first_name varchar(150) [not null, default: '']
  last_name varchar(150) [not null, default: '']
  email varchar(254) [not null, default: '']
  is_staff boolean [not null, default: false]
  is_active boolean [not null, default: true]
  date_joined timestamp [not null, default: `now()`]
}

Table auth_user_groups {
  id bigint [pk, increment]
  user_id int [not null, ref: > auth_user.id]
  group_id int [not null, ref: > auth_group.id]
  indexes {
    (user_id, group_id) [unique]
  }
}

Table auth_user_user_permissions {
  id bigint [pk, increment]
  user_id int [not null, ref: > auth_user.id]
  permission_id int [not null, ref: > auth_permission.id]
  indexes {
    (user_id, permission_id) [unique]
  }
}

Table django_session {
  session_key varchar(40) [pk]
  session_data text [not null]
  expire_date timestamp [not null]
  indexes {
    expire_date
  }
}
